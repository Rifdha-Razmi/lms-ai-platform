# Base URL of the Core LMS API (PRD §8 — /api/v1)
VITE_API_BASE_URL=/api/v1
# true  -> run against the in-browser mock backend (MSW) with seeded demo data
# false -> call the real backend (set VITE_PROXY_TARGET for local dev proxy)
VITE_USE_MOCKS=true
VITE_PROXY_TARGET=http://localhost:4000
VITE_APP_NAME=LMS-AI
